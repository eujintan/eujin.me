+import {test,expect} from '@playwright/test';
+test('keyboard swipe, undo and persistent likes',async({page})=>{await page.goto('/');await expect(page.getByRole('heading',{name:/Train 404/})).toBeVisible();await page.keyboard.press('ArrowRight');await expect(page.getByRole('heading',{name:/W\.A\.M/})).toBeVisible();await page.keyboard.press('Control+z');await expect(page.getByRole('heading',{name:/Train 404/})).toBeVisible();await page.keyboard.press('ArrowRight');await expect(page.getByRole('heading',{name:/W\.A\.M/})).toBeVisible();await page.getByRole('button',{name:/Your likes/}).click();await expect(page.getByRole('heading',{name:/Train 404/})).toBeVisible();await page.reload();await page.getByRole('button',{name:/Your likes/}).click();await expect(page.getByRole('heading',{name:/Train 404/})).toBeVisible();});
+test('project profile opens and Escape closes',async({page})=>{await page.goto('/?project=wam');await expect(page.getByRole('dialog')).toBeVisible();await page.keyboard.press('Escape');await expect(page.getByRole('dialog')).toHaveCount(0);});
+test('mobile navigation and contact draft',async({page})=>{await page.setViewportSize({width:390,height:844});await page.goto('/');await page.getByRole('button',{name:'Chat',exact:true}).click();await page.getByRole('button',{name:'I’m hiring an engineer'}).click();await expect(page.getByRole('textbox',{name:'Draft your message'})).toHaveValue('I’m hiring an engineer');});
